 See https://xbrl.us/dqc-patent for patent infringement notice.
Taxonomy: US GAAP 2026
**/


rule-name-prefix DQC

/** V32 Release **/
/**

Overview: The US GAAP taxonomy models the amount of a lease that has not yet commenced using the element UnrecordedUnconditionalPurchaseObligationBalanceSheetAmount (and the related maturity elements) with the axis UnrecordedUnconditionalPurchaseObligationByCategoryOfItemPurchasedAxis.  The members OperatingLeaseLeaseNotYetCommencedMember and FinancingLeaseLeaseNotYetCommencedMember are used on this axis to distinguish an operating lease that has not yet commenced from a finance lease that has not yet commenced.

Rule US.0251.10964 checks that when an unrecorded unconditional purchase obligation is reported for a lease, the lease is identified using the UnrecordedUnconditionalPurchaseObligationByCategoryOfItemPurchasedAxis and not some other axis.

Rule US.0251.10965 checks that an extension member representing a lease is not used on the UnrecordedUnconditionalPurchaseObligationByCategoryOfItemPurchasedAxis in place of the standard members OperatingLeaseLeaseNotYetCommencedMember and FinancingLeaseLeaseNotYetCommencedMember.

Rule US.0251.10966 checks that the standard members OperatingLeaseLeaseNotYetCommencedMember and FinancingLeaseLeaseNotYetCommencedMember are only used with the unrecorded unconditional purchase obligation elements.

**/

constant $UUPO_CONCEPTS = set(UnrecordedUnconditionalPurchaseObligationBalanceSheetAmount,
                            UnrecordedUnconditionalPurchaseObligationBalanceOnFirstAnniversary,
                            UnrecordedUnconditionalPurchaseObligationBalanceOnSecondAnniversary,
                            UnrecordedUnconditionalPurchaseObligationBalanceOnThirdAnniversary,
                            UnrecordedUnconditionalPurchaseObligationBalanceOnFourthAnniversary,
                            UnrecordedUnconditionalPurchaseObligationBalanceOnFifthAnniversary,
                            UnrecordedUnconditionalPurchaseObligationDueAfterFiveYears,
							UnrecordedUnconditionalPurchaseObligationDueInRemainderOfFiscalYear,
							UnrecordedUnconditionalPurchaseObligationDueInNextRollingTwelveMonths,
							UnrecordedUnconditionalPurchaseObligationDueInRollingYearTwo,
							UnrecordedUnconditionalPurchaseObligationDueInRollingYearThree,
							UnrecordedUnconditionalPurchaseObligationDueInRollingYearFour,
							UnrecordedUnconditionalPurchaseObligationDueInRollingYearFive,
							UnrecordedUnconditionalPurchaseObligationDueInRollingAfterYearFive,
							UnrecordedUnconditionalPurchaseObligationChangeOfAmountAsResultOfVariableComponents,
							UnrecordedUnconditionalPurchaseObligationPurchases,
							UnrecordedUnconditionalPurchaseObligationImputedInterest,)

constant $UUPO_LEASE_MEMBERS = set(OperatingLeaseLeaseNotYetCommencedMember, FinancingLeaseLeaseNotYetCommencedMember)


Assert US.0251.10964 satisfied

$rule_id = (rule-name().split('.'))[rule-name().split('.').length];

/** DQCRT RULE **/
if not applicable_form(rule-name())
	skip
else

$fact1 = {@concept in $UUPO_CONCEPTS}

/** Identify the axes (other than the category axis) where a lease member has been used. Leasehold improvement members are a type of property and are excluded. **/
$factDimensions = $fact1.dimensions-explicit

$leasePairs = list(for $axis in $factDimensions.keys
					$member = $factDimensions[$axis];
					if $axis.name != UnrecordedUnconditionalPurchaseObligationByCategoryOfItemPurchasedAxis and is_lease_member($member.name)
						$axis.name.local-name + ' = ' + $member.name.local-name
					else
						skip)

$leasePairs.length > 0

message
"The filer has reported a value of {$fact1} for the concept {$fact1.concept.name} with the following lease related axis and member combination(s): {$leasePairs.join(', ')}. When an unrecorded unconditional purchase obligation represents a lease that has not yet commenced the lease should be identified using the axis UnrecordedUnconditionalPurchaseObligationByCategoryOfItemPurchasedAxis with the member OperatingLeaseLeaseNotYetCommencedMember or FinancingLeaseLeaseNotYetCommencedMember.  Please update the dimensional qualification of this fact to use the UnrecordedUnconditionalPurchaseObligationByCategoryOfItemPurchasedAxis.

Concept : {$fact1.concept.name}
Value : {$fact1}
Period : {$fact1.period}
Dimensions : {$fact1.dimensions.join(', ','=')}

Rule Element Id:{$rule_id}
Rule version: {$ruleVersion}"

severity error
rule-focus $fact1
effectiveDate $effective_dates[$rule_id]


Assert US.0251.10965 satisfied

$rule_id = (rule-name().split('.'))[rule-name().split('.').length];

/** DQCRT RULE **/
if not applicable_form(rule-name())
	skip
else

$fact1 = {@concept in $UUPO_CONCEPTS @UnrecordedUnconditionalPurchaseObligationByCategoryOfItemPurchasedAxis = *}

$member = $fact1.dimension(UnrecordedUnconditionalPurchaseObligationByCategoryOfItemPurchasedAxis)

is_lease_member($member.name) and $member.name not in $UUPO_LEASE_MEMBERS and is_extension($member, $ALL_BASE_TAXONOMIES_ELTS)

message
"The filer has reported a value of {$fact1} for the concept {$fact1.concept.name} using the extension member {$member.name} on the axis UnrecordedUnconditionalPurchaseObligationByCategoryOfItemPurchasedAxis.  The US GAAP taxonomy includes the members OperatingLeaseLeaseNotYetCommencedMember and FinancingLeaseLeaseNotYetCommencedMember to represent leases that have not yet commenced.  The extension member {$member.name} should be replaced with the appropriate standard member.

Concept : {$fact1.concept.name}
Value : {$fact1}
Period : {$fact1.period}
Dimensions : {$fact1.dimensions.join(', ','=')}

Rule Element Id:{$rule_id}
Rule version: {$ruleVersion}"

severity error
rule-focus $fact1
effectiveDate $effective_dates[$rule_id]


Assert US.0251.10966 satisfied

$rule_id = (rule-name().split('.'))[rule-name().split('.').length];

/** DQCRT RULE **/
if not applicable_form(rule-name())
	skip
else

$fact1 = {@concept not in $UUPO_CONCEPTS @UnrecordedUnconditionalPurchaseObligationByCategoryOfItemPurchasedAxis in $UUPO_LEASE_MEMBERS}

$fact1.concept.is-numeric

message
"The filer has reported a value of {$fact1} for the concept {$fact1.concept.name} with the member {$fact1.dimension(UnrecordedUnconditionalPurchaseObligationByCategoryOfItemPurchasedAxis).name} on the axis UnrecordedUnconditionalPurchaseObligationByCategoryOfItemPurchasedAxis.  The members OperatingLeaseLeaseNotYetCommencedMember and FinancingLeaseLeaseNotYetCommencedMember are intended to be used with the unrecorded unconditional purchase obligation elements such as UnrecordedUnconditionalPurchaseObligationBalanceSheetAmount to report the amount of a lease that has not yet commenced. The concept {$fact1.concept.name} should not be used with this axis and member. If the fact represents the amount of a lease that has not commenced use the element UnrecordedUnconditionalPurchaseObligationBalanceSheetAmount or the related maturity elements.

Concept : {$fact1.concept.name}
Value : {$fact1}
Period : {$fact1.period}
Dimensions : {$fact1.dimensions.join(', ','=')}

Rule Element Id:{$rule_id}
Rule version: {$ruleVersion}"

severity error
rule-focus $fact1
effectiveDate $effective_dates[$rule_id]


/** Returns true if the member name represents a lease. Leasehold improvement members represent property and are excluded. **/
function is_lease_member($memberName)
	$name = $memberName.local-name.lower-case;
	$name.contains('lease') and not $name.contains('leasehold')
