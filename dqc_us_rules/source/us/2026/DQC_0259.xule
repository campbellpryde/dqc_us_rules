rule-name-prefix DQC

/** V32 Release **/
/**

Overview: This rule checks if the BDC uses an extensible enumeration and uses the KVP for that extensible enumeration then the value should match.

**/

ASSERT US.0259.10984 SATISFIED

$rule_id = (rule-name().split('.'))[rule-name().split('.').length];

/** DQCRT RULE **/
if not $BDC_FLAG
	skip
else

$extensibleEnumerationElements = set(InvestmentIssuerAffiliationExtensibleEnumeration, InvestmentIssuerGeographicRegionExtensibleEnumeration, InvestmentTypeExtensibleEnumeration, InvestmentIssuerNameExtensibleEnumeration, InvestmentIndustrySectorExtensibleEnumeration)

$fact= {@concept in $extensibleEnumerationElements @InvestmentIdentifierAxis = *}

$factKVP = $fact.dimension(InvestmentIdentifierAxis)

$fact.concept.name in $factKVP

message
"The fact with concept name {$fact.concept.name} and a value of {$fact} is an extensible enumeration and has no corresponding Key Value Pair (KVP) in the InvestmentIdentifierAxis.  The value of the extensible enumeration fact should be a value specified in the KVP.

Rule Element Id:{$rule_id}
Rule version: {$ruleVersion}"

severity error
rule-focus $fact
effectiveDate $effective_dates[$rule_id]
